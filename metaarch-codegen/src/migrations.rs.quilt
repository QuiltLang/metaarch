//! Migration generator: diff the previous generated spec against the new one
//! and emit `ALTER` steps per `db` block.
//!
//! The previous spec comes from the `system.arch` copy that `generate` leaves
//! in the output root — the `.arch` file stays the only source of truth, and
//! the diff base is just its last generated snapshot, reparsed with the
//! ordinary parser. `migrations` is a pure function of (previous spec, next
//! spec, existing migration counts); the CLI supplies the counts by listing
//! `sql/migrations/` so numbering continues across runs.
//!
//! What diffs to what:
//! - new table → `CREATE TABLE` (the schema generator's own spelling, reused)
//! - dropped table → `DROP TABLE`
//! - added column → `ALTER TABLE … ADD COLUMN` (NOT NULL left off: existing
//!   rows need a backfill first; both engines reject it anyway)
//! - dropped column → `ALTER TABLE … DROP COLUMN`
//! - anything else (type change, pk change, enum variants, engine change) →
//!   a `-- manual migration required` comment; renames read as drop + add
//!
//! A quilt metaprogram against the SQL target, like the schema and seed
//! generators: every statement here is a `sql↖…↗` quote, and the table and
//! column names cross into it through holes. What is left as text is the
//! thing that is not SQL — a `-- manual migration required` note describes a
//! change no `ALTER` expresses, so it is a [`Step::Note`] rather than a term.
//! That also retires the previous version's `column_def(…).replace(" NOT
//! NULL", "")`: the nullable spelling is now its own quote instead of a
//! string edit over rendered DDL.
//!
//! This is the `.rs.quilt` source for the generated `migrations.rs`; run
//! `bin/expand` after editing it, before `cargo build`.

#![allow(clippy::unit_arg)]

use std::collections::BTreeMap;

use metaarch_spec::{Database, Engine, Field, SystemSpec, Ty};
use quilt::prelude::*;

use crate::sql::{create_table, engine_name, sql_ty, table_ref, variant_literals};
use crate::{header, ty_arch, Artifact};

/// One line of a migration file.
enum Step {
    /// A statement the engine runs.
    Statement(⟨T⟩),
    /// A statement plus a trailing comment for whoever applies it.
    Annotated(⟨T⟩, String),
    /// A change no `ALTER` expresses. Not SQL, so not a term.
    Note(String),
}

impl Step {
    fn line(&self) -> String {
        match self {
            Step::Statement(statement) => format!("{};", statement.coparse()),
            Step::Annotated(statement, note) => format!("{}; -- {note}", statement.coparse()),
            Step::Note(note) => format!("-- {note}"),
        }
    }
}

/// `ALTER TABLE … ADD COLUMN …` for a column the previous spec did not have.
///
/// NOT NULL is left off — existing rows need a backfill first, and both
/// engines reject it on a populated table — but an `enum`'s CHECK is kept, so
/// the added column is constrained exactly as `CREATE TABLE` would constrain
/// it.
fn add_column(table: &str, field: &Field, engine: Engine) -> ⟨T⟩ {
    let into = table_ref(table);
    let name = leaf("identifier", &field.name);
    let ty = sql_ty(&field.ty, engine);
    if let Ty::Enum(variants) = &field.ty {
        let literals = variant_literals(variants);
        let statement = sql↖ALTER TABLE ↙into↘ ADD COLUMN ↙name↘ ↙ty↘ CHECK (↙name↘ IN (↙{
            for (index, literal) in literals.into_iter().enumerate() {
                if index > 0 {
                    sym(",").←;
                    " ".←;
                }
                literal.←;
            }
        }↘))↗;
        statement
    } else {
        let statement = sql↖ALTER TABLE ↙into↘ ADD COLUMN ↙name↘ ↙ty↘↗;
        statement
    }
}

fn drop_column(table: &str, column: &str) -> ⟨T⟩ {
    let from = table_ref(table);
    let name = leaf("identifier", column);
    let statement = sql↖ALTER TABLE ↙from↘ DROP COLUMN ↙name↘↗;
    statement
}

fn drop_table(table: &str) -> ⟨T⟩ {
    let name = table_ref(table);
    let statement = sql↖DROP TABLE ↙name↘↗;
    statement
}

/// The migration steps for one service's db, or `None` if nothing changed.
fn db_steps(prev: &Database, next: &Database) -> Option<Vec<Step>> {
    let mut steps: Vec<Step> = Vec::new();
    if prev.engine != next.engine {
        steps.push(Step::Note(format!(
            "manual migration required: engine changed from {} to {}; recreate from sql/schema.sql",
            engine_name(prev.engine),
            engine_name(next.engine),
        )));
        return Some(steps);
    }
    let engine = next.engine;
    for table in &next.tables {
        let Some(prev_table) = prev.tables.iter().find(|t| t.name == table.name) else {
            steps.push(Step::Statement(create_table(table, engine)));
            continue;
        };
        for field in &table.fields {
            let Some(prev_field) = prev_table.fields.iter().find(|f| f.name == field.name) else {
                if field.pk {
                    steps.push(Step::Note(format!(
                        "manual migration required: cannot add PRIMARY KEY column {} to existing table {}",
                        field.name, table.name,
                    )));
                } else {
                    steps.push(Step::Annotated(
                        add_column(&table.name, field, engine),
                        "NOT NULL deferred: backfill existing rows, then add the constraint".into(),
                    ));
                }
                continue;
            };
            if prev_field.ty != field.ty || prev_field.pk != field.pk {
                steps.push(Step::Note(format!(
                    "manual migration required: column {}.{} changed from {}{} to {}{}",
                    table.name,
                    field.name,
                    ty_arch(&prev_field.ty),
                    if prev_field.pk { " pk" } else { "" },
                    ty_arch(&field.ty),
                    if field.pk { " pk" } else { "" },
                )));
            }
        }
        for prev_field in &prev_table.fields {
            if !table.fields.iter().any(|f| f.name == prev_field.name) {
                steps.push(Step::Statement(drop_column(&table.name, &prev_field.name)));
            }
        }
    }
    for prev_table in &prev.tables {
        if !next.tables.iter().any(|t| t.name == prev_table.name) {
            steps.push(Step::Statement(drop_table(&prev_table.name)));
        }
    }
    if steps.is_empty() { None } else { Some(steps) }
}

/// Diff two specs and emit one numbered migration per changed `db` block.
/// `existing` maps service name → how many migrations its `sql/migrations/`
/// already holds; new files continue the numbering.
pub fn migrations(
    prev: &SystemSpec,
    next: &SystemSpec,
    existing: &BTreeMap<String, u32>,
) -> Vec<Artifact> {
    let mut out = Vec::new();
    for service in &next.services {
        let Some(db) = &service.db else { continue };
        // A service (or db block) absent from the previous spec needs no
        // migration: its fresh sql/schema.sql is the starting point.
        let Some(prev_db) = prev
            .services
            .iter()
            .find(|s| s.name == service.name)
            .and_then(|s| s.db.as_ref())
        else {
            continue;
        };
        let Some(steps) = db_steps(prev_db, db) else {
            continue;
        };
        let number = existing.get(service.name.as_str()).copied().unwrap_or(0) + 1;
        let body = steps
            .iter()
            .map(|step| format!("{}\n", step.line()))
            .collect::<String>();
        let contents = format!(
            "{}\n-- Migration {number:04} for service `{}` ({}).\n\n{body}",
            header(&next.name, "--"),
            service.name,
            engine_name(db.engine),
        );
        out.push(Artifact::file(
            format!("{}/sql/migrations/{number:04}.sql", service.name),
            contents,
        ));
    }
    out
}

#[cfg(test)]
mod tests {
    use super::*;
    use metaarch_spec::{Span, Table};
    use quilt::lang::{flat_nodes, Language};
    use quilt::langs::sql::lang::SqlLanguage;

    fn zero() -> Span {
        Span { line: 0, col: 0 }
    }

    fn field(name: &str, ty: Ty) -> Field {
        Field {
            name: name.into(),
            ty,
            pk: false,
            span: zero(),
        }
    }

    fn db(fields: Vec<Field>) -> Database {
        Database {
            engine: Engine::Postgres,
            tables: vec![Table {
                name: "orders".into(),
                fields,
                span: zero(),
            }],
            span: zero(),
        }
    }

    fn lines(prev: &Database, next: &Database) -> Vec<String> {
        db_steps(prev, next)
            .expect("something changed")
            .iter()
            .map(Step::line)
            .collect()
    }

    #[test]
    fn an_added_column_is_nullable_and_keeps_its_check() {
        let prev = db(vec![field("id", Ty::Uuid)]);
        let next = db(vec![
            field("id", Ty::Uuid),
            field("note", Ty::Text),
            field("status", Ty::Enum(vec!["new".into(), "done".into()])),
        ]);
        assert_eq!(
            lines(&prev, &next),
            vec![
                "ALTER TABLE orders ADD COLUMN note TEXT; -- NOT NULL deferred: backfill existing rows, then add the constraint",
                "ALTER TABLE orders ADD COLUMN status TEXT CHECK (status IN ('new', 'done')); -- NOT NULL deferred: backfill existing rows, then add the constraint",
            ]
        );
    }

    #[test]
    fn a_dropped_column_is_altered_away() {
        let prev = db(vec![field("id", Ty::Uuid), field("note", Ty::Text)]);
        let next = db(vec![field("id", Ty::Uuid)]);
        assert_eq!(
            lines(&prev, &next),
            vec!["ALTER TABLE orders DROP COLUMN note;"]
        );
    }

    #[test]
    fn a_changed_type_is_a_note_not_a_statement() {
        let prev = db(vec![field("total", Ty::Int)]);
        let next = db(vec![field("total", Ty::Money)]);
        assert_eq!(
            lines(&prev, &next),
            vec!["-- manual migration required: column orders.total changed from int to money"]
        );
    }

    #[test]
    fn nothing_changed_is_no_migration() {
        let same = db(vec![field("id", Ty::Uuid)]);
        assert!(db_steps(&same, &same).is_none());
    }

    /// Every statement a migration emits reparses in the grammar it was built
    /// from; the notes are comments and are left out of the check.
    #[test]
    fn the_statements_parse_with_quilts_sql_grammar() {
        let prev = db(vec![field("id", Ty::Uuid), field("gone", Ty::Text)]);
        let mut next = db(vec![
            field("id", Ty::Uuid),
            field("status", Ty::Enum(vec!["new".into(), "done".into()])),
        ]);
        next.tables.push(Table {
            name: "shipments".into(),
            fields: vec![field("id", Ty::Uuid)],
            span: zero(),
        });
        let statements: Vec<⟨T⟩> = db_steps(&prev, &next)
            .expect("something changed")
            .into_iter()
            .filter_map(|step| match step {
                Step::Statement(statement) | Step::Annotated(statement, _) => Some(statement),
                Step::Note(_) => None,
            })
            .collect();
        assert_eq!(statements.len(), 3);
        let out = crate::sql::script(statements, crate::sql::Spacing::Tight);
        let nodes = flat_nodes(&out);
        SqlLanguage::default().parse(&nodes).unwrap();
    }
}
