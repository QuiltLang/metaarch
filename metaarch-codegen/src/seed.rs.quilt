//! Seed data generator: one `sql/seed.sql` per `db` block, three
//! deterministic rows per table. Values are a pure function of the field's
//! type, name, and row number, so `generate` stays byte-identical run to run.
//!
//! A quilt metaprogram against the SQL target, like the schema generator. An
//! `INSERT` is the shape this grammar splices best: the table reference, the
//! column list interior and the `VALUES` list interior are all hole
//! positions, so the whole statement is one quote with nothing spelled by
//! hand.
//!
//! What that buys over `format!`: every seeded value crosses into the
//! statement through the lift operator, which makes it a *literal node* — one
//! token, escaped by the SQL target's own rule. The previous text version
//! wrote `'{v}'` around enum variants and `'{name}_{row}'` around text, so a
//! spec that named a variant `it's fine` produced SQL that ended the literal
//! early and then failed to apply. There is no spelling of a variant that can
//! do that here.
//!
//! This is the `.rs.quilt` source for the generated `seed.rs`; run
//! `bin/expand` after editing it, before `cargo build`.

#![allow(clippy::unit_arg)]

use metaarch_spec::{Database, Engine, Field, Service, SystemSpec, Table, Ty};
use quilt::prelude::*;

use crate::sql::{engine_name, script, table_ref, Spacing};
use crate::{header, Artifact};

const ROWS: u32 = 3;

/// The SQL literal seeded into a column for row `row` (1-based), lifted into
/// the SQL target so the escaping is the target's rather than this file's.
fn sql_literal(field: &Field, engine: Engine, row: u32) -> ⟨T⟩ {
    match &field.ty {
        Ty::Uuid => format!("00000000-0000-0000-0000-{row:012}").qlift_to::<Sql>(),
        Ty::Int => row.qlift_to::<Sql>(),
        Ty::Money => (row * 100).qlift_to::<Sql>(),
        Ty::Text => format!("{}_{row}", field.name).qlift_to::<Sql>(),
        // sqlite stores bools as INTEGER; lift the value that engine spells.
        Ty::Bool => match engine {
            Engine::Sqlite => u32::from(row % 2 == 1).qlift_to::<Sql>(),
            Engine::Postgres => (row % 2 == 1).qlift_to::<Sql>(),
        },
        Ty::Timestamp => format!("2026-01-{row:02}T00:00:00Z").qlift_to::<Sql>(),
        Ty::Enum(variants) => {
            // Cycle the variants so every seed file exercises more than one.
            let variant = &variants[(row as usize - 1) % variants.len()];
            variant.as_str().qlift_to::<Sql>()
        }
    }
}

/// One `INSERT` for row `row` of `table`.
fn insert(table: &Table, engine: Engine, row: u32) -> ⟨T⟩ {
    let into = table_ref(&table.name);
    let columns: Vec<⟨T⟩> = table
        .fields
        .iter()
        .map(|field| leaf("identifier", &field.name))
        .collect();
    let values: Vec<⟨T⟩> = table
        .fields
        .iter()
        .map(|field| sql_literal(field, engine, row))
        .collect();
    let statement = sql↖INSERT INTO ↙into↘ (↙{
        for (index, column) in columns.into_iter().enumerate() {
            if index > 0 {
                sym(",").←;
                " ".←;
            }
            column.←;
        }
    }↘) VALUES (↙{
        for (index, value) in values.into_iter().enumerate() {
            if index > 0 {
                sym(",").←;
                " ".←;
            }
            value.←;
        }
    }↘)↗;
    statement
}

pub(crate) fn seed(spec: &SystemSpec, service: &Service, db: &Database) -> Artifact {
    let mut statements: Vec<⟨T⟩> = Vec::new();
    for table in &db.tables {
        for row in 1..=ROWS {
            statements.push(insert(table, db.engine, row));
        }
    }
    let contents = format!(
        "{}\n-- Seed data for service `{}` ({}). Apply after sql/schema.sql.\n\n{}",
        header(&spec.name, "--"),
        service.name,
        engine_name(db.engine),
        script(statements, Spacing::Tight),
    );
    Artifact::file(format!("{}/sql/seed.sql", service.name), contents)
}

#[cfg(test)]
mod tests {
    use super::*;
    use metaarch_spec::Span;
    use quilt::lang::{flat_nodes, Language};
    use quilt::langs::sql::lang::SqlLanguage;

    fn zero() -> Span {
        Span { line: 0, col: 0 }
    }

    fn field(name: &str, ty: Ty) -> Field {
        Field {
            name: name.into(),
            ty,
            pk: false,
            span: zero(),
        }
    }

    fn table() -> Table {
        Table {
            name: "orders".into(),
            fields: vec![
                field("id", Ty::Uuid),
                field("total", Ty::Money),
                field("paid", Ty::Bool),
            ],
            span: zero(),
        }
    }

    #[test]
    fn a_row_is_one_insert() {
        assert_eq!(
            insert(&table(), Engine::Postgres, 2).coparse(),
            "INSERT INTO orders (id, total, paid) VALUES ('00000000-0000-0000-0000-000000000002', 200, FALSE)"
        );
    }

    #[test]
    fn sqlite_spells_bools_as_integers() {
        let out = insert(&table(), Engine::Sqlite, 1).coparse();
        assert!(out.ends_with(", 1)"), "{out}");
    }

    /// The reason the values are lifted rather than formatted: a variant that
    /// would have closed the literal and continued the statement arrives as
    /// one token.
    #[test]
    fn a_value_cannot_break_out_of_its_literal() {
        let table = Table {
            name: "orders".into(),
            fields: vec![field(
                "status",
                Ty::Enum(vec!["x'); DROP TABLE orders; --".into()]),
            )],
            span: zero(),
        };
        assert_eq!(
            insert(&table, Engine::Postgres, 1).coparse(),
            "INSERT INTO orders (status) VALUES ('x''); DROP TABLE orders; --')"
        );
    }

    #[test]
    fn the_seed_parses_with_quilts_sql_grammar() {
        let statements = (1..=ROWS)
            .map(|row| insert(&table(), Engine::Postgres, row))
            .collect();
        let out = script(statements, Spacing::Tight);
        let nodes = flat_nodes(&out);
        SqlLanguage::default().parse(&nodes).unwrap();
    }
}
