//! System-level artifacts: the `bin/main` boot script (generated bash), the
//! `.envrc`, the root cargo workspace, and the README. The generated repo
//! mirrors metaarch's own shape; the flakes and NixOS modules are generated
//! Nix — see `nix.rs.quilt`.
//!
//! This is the `.rs.quilt` source for the generated `system.rs`; run
//! `bin/expand` after editing it, before `cargo build`.

#![allow(clippy::unit_arg)]

use metaarch_spec::{Lang, SystemSpec};
use quilt::prelude::*;

use crate::{Artifact, header};

pub(crate) fn artifacts(spec: &SystemSpec) -> Vec<Artifact> {
    let mut out = vec![
        Artifact::script("bin/main", bin_main(spec)),
        Artifact::file(".envrc", envrc(spec)),
        Artifact::file(
            ".gitignore",
            "/target\n/.direnv\n/.pgdata\n/.process-compose.sock\n__pycache__/\n*.db\n",
        ),
        Artifact::file("README.md", readme(spec)),
    ];
    if spec.services.iter().any(|s| s.lang == Some(Lang::Rust)) {
        out.push(Artifact::file("Cargo.toml", workspace_toml(spec)));
    }
    out
}

fn rust_services(spec: &SystemSpec) -> Vec<&metaarch_spec::Service> {
    spec.services
        .iter()
        .filter(|s| s.lang == Some(Lang::Rust))
        .collect()
}

/// `bin/main`: boot the whole fleet — provision the databases (`bin/db up`,
/// idempotent), build the Rust workspace, start every service, die together
/// (`kill 0` on exit). The postgres servers daemonize outside the process
/// group, so they survive teardown; `bin/db down` stops them.
///
/// `bin/main --process-compose` hands the same fleet to process-compose
/// instead (`process_compose.rs` emits the project file): ordering, readiness
/// probes, restart policy and a TUI rather than this script's `kill 0`. It is
/// opt-in, so the default boot path stays dependency-free.
fn bin_main(spec: &SystemSpec) -> String {
    let mut starts: Vec<⟨T⟩> = Vec::new();
    for service in &spec.services {
        let name = service.name.clone();
        match service.lang.expect("validated: service has a lang") {
            Lang::Rust => starts.push(bash↖cargo run -q -p ↙name.↑↘ &↗),
            Lang::Python => {
                let dir = name.clone();
                // -u: unbuffered stdout, so event logs surface immediately
                // even when bin/main's output is piped or redirected.
                starts.push(bash↖( cd ↙dir.↑↘ && python3 -u -m ↙name.↑↘ ) &↗)
            }
        }
    }
    let has_rust = !rust_services(spec).is_empty();
    let has_db = spec.services.iter().any(|s| s.db.is_some());
    let script = bash↖
        set -euo pipefail
        cd "$(dirname "$0")/.."

        if [ "${1:-}" = "--process-compose" ]; then
            if ! command -v process-compose > /dev/null 2>&1; then
                echo "error: process-compose is not on PATH (it is in the dev shell: direnv allow)" >&2
                exit 1
            fi
            # -U keeps the process-compose API on a unix socket; its TCP
            # default is :8080, which a service here may want for itself.
            # The socket's own default is named after the *caller's* pid, so
            # pin it per project (the .envrc exports the same path) or a
            # second terminal cannot reach the running fleet.
            # The project file runs bin/db and the build as processes, so
            # there is nothing to do first.
            export PC_SOCKET_PATH="${PC_SOCKET_PATH:-$PWD/.process-compose.sock}"
            exec process-compose -U up
        elif [ "$#" -gt 0 ]; then
            echo "usage: bin/main [--process-compose]" >&2
            exit 1
        fi
        ↙{
            if has_db {
                bash↖bin/db up↗.←;
                NL.←;
            }
            if has_rust {
                bash↖cargo build -q↗.←;
                NL.←;
            }
        }↘
        trap 'kill 0' EXIT
        ↙{
            for start in starts {
                start.←;
                NL.←;
            }
        }↘
        wait
    ↗;
    format!(
        "#!/usr/bin/env bash\n{}\n{}",
        header(&spec.name, "#"),
        script.coparse()
    )
}

/// The `.envrc` direnv loads: the generated dev shell, `bin/` on PATH, and
/// one process-compose socket per project — its default is named after the
/// *caller's* pid, so without this a second terminal cannot list, restart or
/// stop the fleet `bin/main --process-compose` started.
fn envrc(spec: &SystemSpec) -> String {
    format!(
        "{}\nuse flake ./nix\n\nPATH_add bin\n\nexport PC_SOCKET_PATH=\"$PWD/.process-compose.sock\"\n",
        header(&spec.name, "#")
    )
}

fn workspace_toml(spec: &SystemSpec) -> String {
    let members = rust_services(spec)
        .iter()
        .map(|s| format!("  \"{}\",\n", s.name))
        .collect::<String>();
    format!(
        "{}\n\n[workspace]\nmembers = [\n{members}]\nresolver = \"2\"\n",
        header(&spec.name, "#")
    )
}

/// The system's front page: topology, ports, and how to poke it with curl.
fn readme(spec: &SystemSpec) -> String {
    use std::fmt::Write as _;
    let has_db = spec.services.iter().any(|s| s.db.is_some());
    let mut out = format!(
        "# {name}\n\n*Generated by metaarch from the `{name}` system description (`system.arch`). Do not edit.*\n\nBoot the fleet with `bin/main`, then check `curl http://127.0.0.1:<port>/health`.\nRun `bin/smoke` for an end-to-end check of every route; open `docs/index.html`\nfor the full API and event reference. `bin/main --process-compose` boots the\nsame fleet under [process-compose](https://f1bonacc1.github.io/process-compose/)\ninstead — see below.\n\n## Services\n\n| service | lang | address | emits | consumes |\n|---|---|---|---|---|\n",
        name = spec.name,
    );
    for (index, service) in spec.services.iter().enumerate() {
        let emits = service
            .emits
            .iter()
            .map(|e| e.name.as_str())
            .collect::<Vec<_>>()
            .join(", ");
        let consumes = service
            .consumes
            .iter()
            .map(|(n, _)| n.as_str())
            .collect::<Vec<_>>()
            .join(", ");
        let _ = writeln!(
            out,
            "| {} | {} | {} | {} | {} |",
            service.name,
            service.lang.expect("validated: service has a lang"),
            crate::service_addr(service, index),
            if emits.is_empty() { "—" } else { &emits },
            if consumes.is_empty() { "—" } else { &consumes },
        );
    }
    out.push_str("\n## Events\n\n");
    for service in &spec.services {
        for event in &service.emits {
            let consumers = crate::consumer_addrs(spec, &event.name);
            let _ = writeln!(
                out,
                "- `{}` — emitted by `{}` (`POST {}` on its address), delivered to {} consumer(s) at `{}`.",
                event.name,
                service.name,
                crate::emit_path(&event.name),
                consumers.len(),
                crate::event_path(&event.name),
            );
        }
    }
    out.push_str(
        "\n## Running under process-compose\n\n`process-compose.yaml` is generated beside this README: one process per\nservice, plus the one-shots they wait for (database provisioning, and one\nworkspace build), an HTTP readiness probe on each service's `/health`, and\nrestart-on-failure. `bin/main --process-compose` runs it — equivalent to\n`process-compose -U up` from this directory, with the TUI and merged logs.\n\nFrom a second terminal in this directory, `process-compose -U process list`,\n`process-compose -U graph` and `process-compose -U down` drive the running\nfleet. `-U` keeps process-compose's own API on a unix socket, since its TCP\ndefault (`:8080`) may be a service's port here; the socket path is pinned to\n`.process-compose.sock` by the `.envrc` (`PC_SOCKET_PATH`), because\nprocess-compose otherwise names it after the calling process.\n\nThe same fleet over the *built* services rather than the source tree is\n`nix run .#fleet-pc`. Like `nix run`, it starts services only — run\n`bin/db up` first if this system has databases to provision.\n",
    );
    out.push_str(
        "\n## Deployment\n\nThe root `flake.nix` builds every service (`nix build .#<service>`), runs\nthem (`nix run .#<service>`, or `nix run` for the whole fleet), and exports\na NixOS module per service (`nixosModules.<service>`, from\n`nix/modules/`). Initialize git first (`git init && git add -A`) so flake\nevaluation filters `target/` out of the source copy. The dev shell lives in\n`nix/flake.nix` and is what the `.envrc` loads.\n",
    );
    if has_db {
        out.push_str(
            "\n`bin/db up` provisions the databases (postgres clusters under `.pgdata/`,\nunix-socket only; sqlite files next to their service) and applies the\ngenerated schema and seed on first creation. `bin/main` runs it\nautomatically; `bin/db down` stops the postgres servers, which outlive the\nfleet. `sql/migrations/` is for pre-existing databases and is applied\nmanually.\n",
        );
    }
    out
}
