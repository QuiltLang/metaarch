//! System-level artifacts: the `bin/main` boot script (generated bash), the
//! dev env (`.envrc` + `nix/flake.nix`), the root cargo workspace, and the
//! README. The generated repo mirrors metaarch's own shape.
//!
//! This is the `.rs.quilt` source for the generated `system.rs`; run
//! `bin/expand` after editing it, before `cargo build`. The flake is plain
//! text until phase 3 lands the `.nix.quilt` generator.

#![allow(clippy::unit_arg)]

use metaarch_spec::{Lang, SystemSpec};
use quilt::prelude::*;

use crate::{Artifact, header};

pub(crate) fn artifacts(spec: &SystemSpec) -> Vec<Artifact> {
    let mut out = vec![
        Artifact::script("bin/main", bin_main(spec)),
        Artifact::file(".envrc", envrc(spec)),
        Artifact::file("nix/flake.nix", flake(spec)),
        Artifact::file(".gitignore", "/target\n/.direnv\n__pycache__/\n"),
        Artifact::file("README.md", readme(spec)),
    ];
    if spec.services.iter().any(|s| s.lang == Some(Lang::Rust)) {
        out.push(Artifact::file("Cargo.toml", workspace_toml(spec)));
    }
    out
}

fn rust_services(spec: &SystemSpec) -> Vec<&metaarch_spec::Service> {
    spec.services
        .iter()
        .filter(|s| s.lang == Some(Lang::Rust))
        .collect()
}

/// `bin/main`: boot the whole fleet — build the Rust workspace, start every
/// service, die together (`kill 0` on exit).
fn bin_main(spec: &SystemSpec) -> String {
    let mut starts: Vec<⟨T⟩> = Vec::new();
    for service in &spec.services {
        let name = service.name.clone();
        match service.lang.expect("validated: service has a lang") {
            Lang::Rust => starts.push(bash↖cargo run -q -p ↙name.↑↘ &↗),
            Lang::Python => {
                let dir = name.clone();
                // -u: unbuffered stdout, so event logs surface immediately
                // even when bin/main's output is piped or redirected.
                starts.push(bash↖( cd ↙dir.↑↘ && python3 -u -m ↙name.↑↘ ) &↗)
            }
        }
    }
    let has_rust = !rust_services(spec).is_empty();
    let script = bash↖
        set -euo pipefail
        cd "$(dirname "$0")/.."
        ↙{
            if has_rust {
                bash↖cargo build -q↗.←;
                NL.←;
            }
        }↘
        trap 'kill 0' EXIT
        ↙{
            for start in starts {
                start.←;
                NL.←;
            }
        }↘
        wait
    ↗;
    format!(
        "#!/usr/bin/env bash\n{}\n{}",
        header(&spec.name, "#"),
        script.coparse()
    )
}

fn envrc(spec: &SystemSpec) -> String {
    format!(
        "{}\nuse flake ./nix\n\nPATH_add bin\n",
        header(&spec.name, "#")
    )
}

/// A minimal dev shell with every toolchain the fleet needs. Plain text for
/// now: phase 3 replaces this with the `.nix.quilt` generator (generated
/// NixOS modules, db provisioning, per-service apps).
fn flake(spec: &SystemSpec) -> String {
    let mut packages = Vec::new();
    if spec.services.iter().any(|s| s.lang == Some(Lang::Rust)) {
        packages.extend(["pkgs.cargo", "pkgs.rustc"]);
    }
    if spec.services.iter().any(|s| s.lang == Some(Lang::Python)) {
        packages.push("pkgs.python3");
    }
    // bin/smoke drives every route with curl.
    packages.push("pkgs.curl");
    format!(
        r#"{header}
{{
  description = "Dev environment for the generated `{name}` system";

  inputs = {{
    nixpkgs.url = "github:NixOS/nixpkgs/nixpkgs-unstable";
    flake-utils.url = "github:numtide/flake-utils";
  }};

  outputs = {{ self, nixpkgs, flake-utils }}:
    flake-utils.lib.eachDefaultSystem (system:
      let
        pkgs = nixpkgs.legacyPackages.${{system}};
      in {{
        devShells.default = pkgs.mkShell {{
          packages = [ {packages} ];
        }};
      }});
}}
"#,
        header = header(&spec.name, "#"),
        name = spec.name,
        packages = packages.join(" ")
    )
}

fn workspace_toml(spec: &SystemSpec) -> String {
    let members = rust_services(spec)
        .iter()
        .map(|s| format!("  \"{}\",\n", s.name))
        .collect::<String>();
    format!(
        "{}\n\n[workspace]\nmembers = [\n{members}]\nresolver = \"2\"\n",
        header(&spec.name, "#")
    )
}

/// The system's front page: topology, ports, and how to poke it with curl.
fn readme(spec: &SystemSpec) -> String {
    use std::fmt::Write as _;
    let mut out = format!(
        "# {name}\n\n*Generated by metaarch from the `{name}` system description (`system.arch`). Do not edit.*\n\nBoot the fleet with `bin/main`, then check `curl http://127.0.0.1:<port>/health`.\nRun `bin/smoke` for an end-to-end check of every route; open `docs/index.html`\nfor the full API and event reference.\n\n## Services\n\n| service | lang | address | emits | consumes |\n|---|---|---|---|---|\n",
        name = spec.name,
    );
    for (index, service) in spec.services.iter().enumerate() {
        let emits = service
            .emits
            .iter()
            .map(|e| e.name.as_str())
            .collect::<Vec<_>>()
            .join(", ");
        let consumes = service
            .consumes
            .iter()
            .map(|(n, _)| n.as_str())
            .collect::<Vec<_>>()
            .join(", ");
        let _ = writeln!(
            out,
            "| {} | {} | {} | {} | {} |",
            service.name,
            service.lang.expect("validated: service has a lang"),
            crate::service_addr(service, index),
            if emits.is_empty() { "—" } else { &emits },
            if consumes.is_empty() { "—" } else { &consumes },
        );
    }
    out.push_str("\n## Events\n\n");
    for service in &spec.services {
        for event in &service.emits {
            let consumers = crate::consumer_addrs(spec, &event.name);
            let _ = writeln!(
                out,
                "- `{}` — emitted by `{}` (`POST {}` on its address), delivered to {} consumer(s) at `{}`.",
                event.name,
                service.name,
                crate::emit_path(&event.name),
                consumers.len(),
                crate::event_path(&event.name),
            );
        }
    }
    out
}
