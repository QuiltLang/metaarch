#!/usr/bin/env bash
# Main entrypoint: the metaarch CLI (check / dump / generate / fmt), or —
# with no arguments — the guided demo tour (bin/demo). Works from anywhere
# when the direnv env is active.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if [ $# -eq 0 ]; then
    exec "$ROOT/bin/demo"
fi
exec cargo run --manifest-path "$ROOT/Cargo.toml" -p metaarch -- "$@"
