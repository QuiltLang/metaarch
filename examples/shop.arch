# A tiny web shop: two Rust services, a Python consumer, one event.
# Check it:     bin/main check examples/shop.arch
# Generate it:  bin/main generate examples/shop.arch
# Boot it:      cd out/shop && bin/main
system shop

service gateway {
  lang rust
  port 8080
  # Inline handler body (the phase-4 escape hatch): the fragment between the
  # arrow brackets is the tail expression of the generated axum handler.
  impl get /hello ↖
    "hello from an inline fragment!\n"
  ↗
}

service orders {
  lang rust
  port 8081
  db postgres {
    table orders {
      id: uuid pk,
      user_id: uuid,
      total: money,
      status: enum(pending, paid, shipped),
      placed_at: timestamp,
    }
  }
  emits OrderPlaced { order_id: uuid, total: money }
}

service notifier {
  lang python
  consumes OrderPlaced
  # Python fragments are the body of a function returning the response text.
  impl get /stats ↖
    return "notifier alive\n"
  ↗
}
