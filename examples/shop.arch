# A tiny web shop: two Rust services, a Python consumer, one event.
# Check it:     bin/main check examples/shop.arch
# Generate it:  bin/main generate examples/shop.arch
# Boot it:      cd out/shop && bin/main
system shop

service gateway {
  lang rust
  port 8080
  # Inline handler body: the fragment between the arrow brackets is parsed
  # with the real Rust grammar and spliced in as the tail expression of the
  # generated axum handler. The language annotation (`rust↖`, the same
  # spelling a .arch.quilt quote uses) is optional — it must match `lang`.
  impl get /hello rust↖
    "hello from an inline fragment!\n"
  ↗
}

service orders {
  lang rust
  port 8081
  db postgres {
    table orders {
      id: uuid pk,
      user_id: uuid,
      total: money,
      status: enum(pending, paid, shipped),
      placed_at: timestamp,
    }
  }
  emits OrderPlaced { order_id: uuid, total: money }
}

service notifier {
  lang python
  consumes OrderPlaced
  # Python fragments are the body of a function returning the response text
  # (parsed with the real Python grammar; annotation left off here).
  impl get /stats ↖
    return "notifier alive\n"
  ↗
}
