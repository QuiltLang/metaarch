# A .arch.quilt file: arch parsed as a *dynamically registered* quilt
# language (phase 4b). The impl fragment below is not an opaque string here —
# it is a real rust quote, parsed by tree-sitter inside the arch tree:
#   cargo run -p metaarch-expand -- parse examples/hello.arch.quilt
# Expansion of arch hosts (splicing the quote into generated code) arrives
# with phase 4c's arch MetaLanguage.
system hello

service greeter {
  lang rust
  port 8080
  impl get /hello rust↖
    "hello from a parsed quote!\n"
  ↗
}
